+pub(super) enum PtyPipe {
+    Duplex(mio::windows::NamedPipe),
+    Split {
+        reader: mio::windows::NamedPipe,
+        writer: mio::windows::NamedPipe,
+    },
+}
+
+impl std::io::Read for PtyPipe {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        match self {
+            Self::Duplex(pipe) => std::io::Read::read(pipe, buf),
+            Self::Split { reader, .. } => std::io::Read::read(reader, buf),
+        }
+    }
+}
+
+impl std::io::Write for PtyPipe {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        match self {
+            Self::Duplex(pipe) => std::io::Write::write(pipe, buf),
+            Self::Split { writer, .. } => std::io::Write::write(writer, buf),
+        }
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        match self {
+            Self::Duplex(pipe) => std::io::Write::flush(pipe),
+            Self::Split { writer, .. } => std::io::Write::flush(writer),
+        }
+    }
+}
+
+impl PtyPipe {
+    fn register(&mut self, poll: &mio::Poll, interest: mio::Interest) -> std::io::Result<()> {
+        match self {
+            Self::Duplex(pipe) => poll.registry().register(pipe, PTY_TOKEN, interest),
+            Self::Split { reader, writer } => {
+                poll.registry()
+                    .register(reader, PTY_TOKEN, mio::Interest::READABLE)?;
+                poll.registry()
+                    .register(writer, PTY_WRITE_TOKEN, mio::Interest::WRITABLE)
+            }
+        }
+    }
+
+    fn reregister(&mut self, poll: &mio::Poll, interest: mio::Interest) -> std::io::Result<()> {
+        match self {
+            Self::Duplex(pipe) => poll.registry().reregister(pipe, PTY_TOKEN, interest),
+            Self::Split { reader, writer } => {
+                poll.registry()
+                    .reregister(reader, PTY_TOKEN, mio::Interest::READABLE)?;
+                poll.registry()
+                    .reregister(writer, PTY_WRITE_TOKEN, mio::Interest::WRITABLE)
+            }
+        }
+    }
+
+    fn deregister(&mut self, poll: &mio::Poll) -> std::io::Result<()> {
+        match self {
+            Self::Duplex(pipe) => poll.registry().deregister(pipe),
+            Self::Split { reader, writer } => {
+                poll.registry().deregister(reader)?;
+                poll.registry().deregister(writer)
+            }
+        }
+    }
+
+    fn read_token(&self) -> mio::Token {
+        PTY_TOKEN
+    }
+
+    fn write_token(&self) -> mio::Token {
+        match self {
+            Self::Duplex(_) => PTY_TOKEN,
+            Self::Split { .. } => PTY_WRITE_TOKEN,
+        }
+    }
+
+    fn drain_and_disconnect(&mut self) {
+        let mut buffer = [0; 1000];
+        match self {
+            Self::Duplex(pipe) => {
+                while let Ok(bytes_read) = std::io::Read::read(pipe, &mut buffer) {
+                    if bytes_read == 0 {
+                        break;
+                    }
+                }
+                let _ = pipe.disconnect();
+            }
+            Self::Split { reader, writer } => {
+                // Stop accepting input first, while leaving the output side alive long enough to
+                // drain anything emitted while the legacy ClosePseudoConsole call completes.
+                let _ = writer.disconnect();
+                while let Ok(bytes_read) = std::io::Read::read(reader, &mut buffer) {
+                    if bytes_read == 0 {
+                        break;
+                    }
+                }
+                let _ = reader.disconnect();
+            }
+        }
+    }
+}
